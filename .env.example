# WeatherGPT — environment configuration
# Copy this file to `.env` and fill in values. No API key is required to run:
# without VITE_OPENAI_API_KEY, the app falls back to the browser's built-in
# Web Speech recognition for voice search.

# --- Voice search (optional) ---
# OpenAI API key for Whisper transcription of voice commands.
# When set, voice search uses the OpenAI transcriptions API (better accuracy for
# Indian-English, Hindi, and Kannada). When empty, the browser Web Speech API is used.
VITE_OPENAI_API_KEY=

# Whisper transcription model to use. Default: gpt-4o-mini-transcribe
# Alternatives: whisper-1
VITE_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe